

# LifeMap environment variables
# Copy to .env and fill in values.
# IMPORTANT: secrets must NEVER use VITE_ prefix — they go in Edge Functions only.
# Only public-safe config gets VITE_ prefix.

# Supabase (safe to expose — these are anon/public keys)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# DO NOT add secrets here. Fitbit tokens, service_role key, and any LLM API
# keys live in Supabase Edge Function environment variables ONLY.
